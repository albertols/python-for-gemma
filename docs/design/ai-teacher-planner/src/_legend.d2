# Colour legend. Import with `...@_legend` after `...@_style` in any diagram
# where colour carries meaning.

vars: {
  d2-legend: {
    l1: "Our code" {class: concept}
    l2: "Data that stays on the Mac" {class: win}
    l3: "Boundary or guard" {class: warn}
    l4: "AI involved" {class: ai}
    l5: "Later" {class: later}
  }
}
