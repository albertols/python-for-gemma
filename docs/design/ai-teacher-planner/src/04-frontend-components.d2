...@_style

vars: {
  d2-legend: {
    l1: "Our code" {class: concept}
    l4: "AI involved" {class: ai}
  }
}

title: |md
  # Frontend components: screens and shared pieces
  Eleven screens share seven pieces; the purple ones are where AI shows up. Every plan change goes through the proposal dialog before it is stored.
| {near: top-center}

grid-columns: 1
grid-gap: 70

screens: "Screens" {
  class: group
  grid-rows: 2
  grid-columns: 6
  grid-gap: 16

  today: "Today\nlessons with the plan's lesson,\nreminders, cancel lessons,\nto-do notes, out-of-date banner" {class: concept}
  board: "Fortnight board\nlesson cards and states,\nspare lessons, declared band,\nundo, out-of-date banner" {class: concept}
  sow: "Scheme of work\nlive fit totals, import preview,\nAI counts as differences,\nout-of-date banner" {class: ai}
  parity: "Parity\nslack, gaps,\ncatch-up options" {class: concept}
  audit: "Slot audit\nlost lessons and why,\nlast lessons, official exams" {class: concept}
  hl: "IB HL helper\nteachable now,\nunlocks on" {class: concept}
  coverage: "Coverage\ntaught, assessed\nper spec point" {class: concept}
  assess: "Assessments\nand reports\nclashes, deadlines" {class: concept}
  resources: "Resources\nrefresher, cover,\nindependent task" {class: ai}
  packreview: "Pack review\nunits, spec points, chapter links,\nAI reasons, lock" {class: ai}
  setup: "Setup\ncalendar + corrections, timetable,\ncancelled lessons, events, exams,\npositions + ask for a plan" {class: concept}
}

shared: "Shared pieces" {
  class: group
  grid-rows: 1
  grid-columns: 7
  grid-gap: 16

  badge: "AI badge + popover\nsparkle, dashed outline,\nprovider, model, sources" {class: ai}
  diff: "Proposal dialog + diff\nsummary, conflicts, changes;\naccept or cancel, stale refusal" {class: concept}
  card: "Lesson card\nlesson, state in words,\nspare lesson, assessment chip" {class: concept}
  drawer: "Activity drawer + job chip\nevery AI run, live progress,\naccept, edit, reject" {class: ai}
  legend: "Legend\nwhat each mark means" {class: ai}
  client: "API client\ntyped from\nOpenAPI" {class: concept}
  engineimport: "Engine import\ninstant previews" {class: concept}
}

outside: "What the web app talks to" {
  class: group
  grid-rows: 1
  grid-columns: 2
  grid-gap: 16

  api: "Local API\nREST + progress events" {class: concept}
  engine: "Engine: packages/domain\npure TypeScript, runs in the browser" {class: concept}
}

screens -> shared: "every screen uses" {class: flow}
shared -> outside: "API client calls the API;\nengine import runs the engine" {class: flow}
